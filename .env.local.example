# Copy to .env.local; never commit the populated file.
# Generate independent high-entropy secrets (e.g. openssl rand -hex 32).
LOCAL_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
# MUST match CLOUD_SYNC_SHARED_SECRET on the Render receiver.
CLOUD_SYNC_SHARED_SECRET=REPLACE_WITH_SHARED_SECRET_AT_LEAST_32_CHARACTERS
