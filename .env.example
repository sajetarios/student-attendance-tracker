# Required for authenticated local-to-cloud attendance forwarding.
# Generate a random value with at least 32 characters and set the SAME secret
# on the local attendance server and its cloud destination.
CLOUD_SYNC_SHARED_SECRET=

# SMS sends only after server configuration AND School Admin activation.
SMS_DELIVERY_ENABLED=false
SEMAPHORE_API_KEY=
# Optional: must be an approved sender name in your Semaphore account.
SEMAPHORE_SENDER_NAME=
