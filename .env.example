# Copy to .env for local development. Never commit the real .env file.
DATABASE_URL=postgres://user:password@localhost:5432/attendigo
PORT=3000

# Set to "require" when connecting to a hosted database through its external URL.
# PGSSLMODE=require

# Production (Render sets NODE_ENV and PORT for you)
# NODE_ENV=production
# STORAGE_DIR=/var/data        # persistent disk for photos and submitted SF2 files
# AUTH_SESSION_HOURS=12
# LOGIN_RATE_LIMIT=30          # sign-in attempts per 15 minutes per IP address
# TRUST_PROXY=1                # number of reverse proxies in front of the app
# FORCE_HTTPS=true             # redirect http to https (default in production)

# SMS worker (Semaphore)
# SEMAPHORE_API_KEY=
# SEMAPHORE_SENDER_NAME=
# SMS_POLL_INTERVAL_MS=5000
# SMS_MAX_ATTEMPTS=5
