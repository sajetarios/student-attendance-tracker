# Required for authenticated local-to-cloud attendance forwarding.
# Generate a random value with at least 32 characters and set the SAME secret
# on the local school server (do not commit real credentials).
CLOUD_SYNC_SHARED_SECRET=

# On the CLOUD receiving deployment, configure per-school HMAC secrets as a
# JSON object mapping registered school codes to their local server secrets.
# Example structure only; replace each placeholder with a DIFFERENT random secret:
# CLOUD_SYNC_SCHOOL_SECRETS_JSON={"SCHOOL001":"<random-32-plus-chars>"}
CLOUD_SYNC_SCHOOL_SECRETS_JSON=

# SMS sends only after server configuration AND School Admin activation.
SMS_DELIVERY_ENABLED=false
SEMAPHORE_API_KEY=
# Optional: must be an approved sender name in your Semaphore account.
SEMAPHORE_SENDER_NAME=

# Optional generative answers for Attendigo Guide (server-only secret)
# ATTENDIGO_HELP_AI_API_KEY=
ATTENDIGO_HELP_AI_MODEL=gpt-4.1-mini
